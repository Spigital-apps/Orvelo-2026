# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# --- Webinar Registration: Google Sheets & Email Confirmation ---
# Option A (Recommended): Deploy /scripts/google-apps-script.gs from the info@spigital.com account
# and set the Web App URL here to both append rows to your Google Sheet and email registrants from info@spigital.com.
GOOGLE_SHEETS_WEBHOOK_URL=""

# Option B: Direct Google Sheets API Service Account (if not using Apps Script)
GOOGLE_SHEET_ID=""
GOOGLE_SHEET_TAB="Sheet1"
GOOGLE_SERVICE_ACCOUNT_EMAIL=""
GOOGLE_PRIVATE_KEY=""

# Direct SMTP Configuration for sending confirmation emails from info@spigital.com
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="465"
SMTP_SECURE="true"
SMTP_USER="info@spigital.com"
SMTP_PASS=""
WEBINAR_SENDER_EMAIL="info@spigital.com"
WEBINAR_SENDER_NAME="Orvelo.ai | Spigital"

# Optional lead alert fallback via Web3Forms
WEB3FORMS_ACCESS_KEY=""
